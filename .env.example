# ==================================================================
# Environment configuration
# ==================================================================
# To set up: copy this file and fill in your values.
#   cp .env.example .env
#
# Which env file does the app read?
#   - On your machine: .env (Next.js reads it automatically)
#   - On servers:      the deploy pipeline writes .env during the build
#
# All keys start with NEXT_PUBLIC_ because the browser needs them.
# Their values are baked into the app at build time — after changing
# one, restart the dev server (or rebuild).
#
# Every key is checked on startup by src/env.mjs —
# if you add or remove a key there, update this file too.
# ==================================================================


# ==================================================================
# Backend connection
# ==================================================================
# (required) Base URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# (required) Socket.IO endpoint — the backend server itself, no /api suffix
NEXT_PUBLIC_WSS_ENDPOINT=http://localhost:8000


# ==================================================================
# Stripe — https://dashboard.stripe.com/apikeys
# ==================================================================
# (required) Publishable key (safe for the browser, never the secret key)
NEXT_PUBLIC_STRIPE_KEY=pk_test_xxx


# ==================================================================
# GetStream (chat) — https://dashboard.getstream.io
# ==================================================================
# (required) API key only — the secret stays on the backend
NEXT_PUBLIC_STREAM_API_KEY=<getstream-api-key>


# ==================================================================
# OneSignal (push notifications) — https://dashboard.onesignal.com
# ==================================================================
# (required)
NEXT_PUBLIC_ONE_SIGNAL_APP_ID=<onesignal-app-id>
